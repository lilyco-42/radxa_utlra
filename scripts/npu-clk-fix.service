[Unit]
Description=A733 NPU fixup: bind NPU driver + enable clk_npu + pin power domain on
# 6.6 BSP (6.6.98-4-aw2511) 上 galcore 只 clk_prepare 从不 clk_enable,
# 且 pd_npu 电源域保持 off —— NPU 无时钟无供电,任务提交超时。
# 本服务:确保 NPU 绑到**实际存在的**驱动 → 加载 npu_clk_fix.ko → 钉电源域。
After=npu-galcore.service systemd-modules-load.service
Wants=npu-galcore.service

[Service]
Type=oneshot
RemainAfterExit=yes

# ⚠️ 绑定逻辑必须**先探测哪个驱动存在**,不能无条件往 galcore 绑。
#
# 踩过的坑(2026-09-19): 原实现是无条件 `unbind vipcore` + `bind galcore`。
# 但 Radxa 这个内核里 CONFIG_AW_NNA_GALCORE is not set —— **根本没有 galcore 驱动**。
# 于是执行结果是: 先解绑 vipcore,再往不存在的 galcore 绑定(静默失败),
# NPU 变成**谁都没绑**,/dev/vipcore 直接消失 —— 比不修还坏。
# 修复后必须手动 `echo 3600000.npu > /sys/bus/platform/drivers/vipcore/bind` 才恢复。
#
# galcore 与 vipcore 在官方内核里是互斥的(只能有一个),所以必须先判断存在性。
ExecStartPre=/bin/sh -c 'if [ -d /sys/bus/platform/drivers/galcore ]; then DRV=galcore; DEV=/dev/galcore; else DRV=vipcore; DEV=/dev/vipcore; fi; if [ ! -e /sys/bus/platform/drivers/$DRV/3600000.npu ]; then for d in vipcore galcore; do [ -e /sys/bus/platform/drivers/$d/3600000.npu ] && echo 3600000.npu > /sys/bus/platform/drivers/$d/unbind; done; sleep 1; echo 3600000.npu > /sys/bus/platform/drivers/$DRV/bind; fi; sleep 1; [ -c "$DEV" ] && chmod 666 "$DEV"; true'

ExecStart=/bin/sh -c "grep -qw npu_clk_fix /proc/modules || /sbin/insmod /home/radxa/npu-clk-fix/npu_clk_fix.ko"

# 钉住电源域: 设备 runtime-PM 保持 active → pd_npu on
ExecStartPost=/bin/sh -c "echo on > /sys/bus/platform/devices/3600000.npu/power/control"

[Install]
WantedBy=multi-user.target
